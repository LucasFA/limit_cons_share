					enabled = "[GetScriptedGui('lcs_set_cap_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)65' ) ).End )]"
