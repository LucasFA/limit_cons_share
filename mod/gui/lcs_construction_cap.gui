# Government Construction Cap control, shown in the budget panel under the
# Pause/Resume All Construction buttons (see the one-line hook in gui/budget_panel.gui).

types lcs_construction_cap_types
{
	type lcs_construction_cap_control = flowcontainer {
		name = "lcs_construction_cap_control"
		direction = horizontal
		spacing = 6
		margin_bottom = 10
		datacontext = "[GetPlayer]"

		textbox = {
			size = { 150 28 }
			parentanchor = vcenter
			text = "LCS_CAP_LABEL"
			tooltip = "LCS_CAP_TOOLTIP"
			using = tooltip_above
			align = left|nobaseline
			elide = right
			fontsize_min = 12
		}

		button_icon_minus_action = {
			size = { 28 28 }
			parentanchor = vcenter
			tooltip = "LCS_CAP_LOWER_TOOLTIP"
			using = tooltip_above
			onclick = "[GetScriptedGui('lcs_lower_cap_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			enabled = "[GetScriptedGui('lcs_lower_cap_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		# Clickable bar: 20 segments of 5%
		widget = {
			size = { 240 22 }
			parentanchor = vcenter
			tooltip = "LCS_CAP_TOOLTIP"
			using = tooltip_above

			default_progressbar_horizontal = {
				size = { 100% 100% }
				blockoverride "values" {
					min = 0
					max = 100
					value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('lcs_cap_percent') )]"
				}
			}

			flowcontainer = {
				direction = horizontal
				spacing = 0

				button = {
					size = { 12 22 }
					texture = "gfx/interface/icons/generic_icons/transparent.dds"
					tooltip = "LCS_CAP_TOOLTIP"
					using = tooltip_above
					onclick = "[GetScriptedGui('lcs_set_cap_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
					enabled = "[GetScriptedGui('lcs_set_cap_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
				}

				button = {
					size = { 12 22 }
					texture = "gfx/interface/icons/generic_icons/transparent.dds"
					tooltip = "LCS_CAP_TOOLTIP"
					using = tooltip_above
					onclick = "[GetScriptedGui('lcs_set_cap_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
					enabled = "[GetScriptedGui('lcs_set_cap_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
				}

				button = {
					size = { 12 22 }
					texture = "gfx/interface/icons/generic_icons/transparent.dds"
					tooltip = "LCS_CAP_TOOLTIP"
					using = tooltip_above
					onclick = "[GetScriptedGui('lcs_set_cap_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)15' ) ).End )]"
					enabled = "[GetScriptedGui('lcs_set_cap_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)15' ) ).End )]"
				}

				button = {
					size = { 12 22 }
					texture = "gfx/interface/icons/generic_icons/transparent.dds"
					tooltip = "LCS_CAP_TOOLTIP"
					using = tooltip_above
					onclick = "[GetScriptedGui('lcs_set_cap_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)20' ) ).End )]"
					enabled = "[GetScriptedGui('lcs_set_cap_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'lcs_value', MakeScopeValue( '(CFixedPoint)20' ) ).End )]"
